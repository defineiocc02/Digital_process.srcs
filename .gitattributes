* text=auto

# Source and documentation files are kept LF-normalized in Git.
*.sv  text eol=lf
*.v   text eol=lf
*.vh  text eol=lf
*.xdc text eol=lf
*.tcl text eol=lf
*.py  text eol=lf
*.sh  text eol=lf
*.m   text eol=lf
*.xpr text eol=lf
*.md  text eol=lf
*.yml text eol=lf

# Windows entrypoints remain CRLF in the working tree.
*.ps1 text eol=crlf
*.bat text eol=crlf

# Binary artifacts stay binary.
*.pdf binary
*.rar binary
*.zip binary
*.7z  binary
